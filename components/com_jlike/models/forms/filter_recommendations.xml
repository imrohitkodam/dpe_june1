<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter" addfieldpath="/components/com_jlike/models/fields/">
		<field
			name="search"
			type="text"
			filter="string"
			hint="JLIKE_JSEARCH_FILTER"
		/>

		<field name="agency_id"
			type="cluster"
			filter="integer"
			onchange="this.form.submit();" 
			addfieldpath="administrator/components/com_tjfields/models/fields"
			/>

		<field 
			name="status" 
			type="list" 
			label="COM_JLIKE_FORM_LBL_TODO_STATUS" 
			description="COM_JLIKE_FORM_LBL_TODO_STATUS_DESC"
			onchange="this.form.submit();"
			>
		  <option value="">COM_JLIKE_SELECT_STATUS</option>
		  <option value="C">COM_JLIKE_FORM_TODO_STATUS_COMPLETED</option>
		  <option value="I">COM_JLIKE_FORM_TODO_STATUS_INCOMPLETED</option>
		  <option value="O">COM_JLIKE_FORM_TODO_STATUS_OVERDUE</option>
		</field>

		<field 
			name="records" 
			default="S" 
			type="list" 
			label="COM_JLIKE_RECORDS" 
			description="COM_JLIKE_RECORDS_DESC"
			onchange="this.form.submit();"
			>
		  <option value="">COM_JLIKE_SELECT_RECORD</option>
		  <option value="assigned_by">COM_JLIKE_RECORD_ASSIGNED_BY_ME</option>
		  <option value="assigned_to">COM_JLIKE_RECORD_ASSIGNED_TO_ME</option>
		</field>

		<field 
			name="client" 
			type="getclientlist" 
			description="COM_JLIKE_TITLE_TODO_CALENDAR_CLIENT_FILTER_DESC" 
			label="COM_JLIKE_TITLE_TODO_CALENDAR_CLIENT_FILTER" 
			default=""
			onchange="this.form.submit();"
			/>

		<field
			name="date_from"
			type="calendar"
			translateformat="false"
			format="%d-%m-%Y"
			showtime="false"
			filter="user_utc"
			singleheader="true"
			filltable="true"
			hint="COM_JLIKE_DATE_FROM_HINT"
			todaybutton="true"
			class="calendar-textfield-class"
			onchange="this.form.submit();"
		/>

		<field
			name="date_to"
			type="calendar"
			translateformat="false"
			format="%d-%m-%Y"
			showtime="false"
			filter="user_utc"
			singleheader="true"
			filltable="true"
			hint="COM_JLIKE_DATE_TO_HINT"
			todaybutton="true"
			class="calendar-textfield-class"
			onchange="this.form.submit();"
		/>
		<!--DPE Hack union is done to add select tag in first option of the list-->
			<field
			name="tags"
			type="sql"
			query="SELECT DISTINCT tags.title ,tags.id
					FROM `#__tags` as tags INNER JOIN  `#__contentitem_tag_map` as tagMap  ON tags.id=tagMap.tag_id where type_alias='com_multiagency.multiagency' ORDER BY tags.title ASC;"
			key_field="id"
			value_field="title"
			translate="false"
			label="COM_DPE_FORM_LBL_TAG"
			description="COM_DPE_FORM_LBL_TAG_DESC"
			onchange="this.form.submit();"
			filter="INT"
			multiple="multiple"
		/>
		<!--DPE Hack End-->
	</fields>

	<fields name="list">
		<field
			name="limit"
			type="limitbox"
			class="input-small"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</form>

