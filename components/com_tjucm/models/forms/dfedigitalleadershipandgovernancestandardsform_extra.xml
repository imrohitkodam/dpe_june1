<form><fieldset name="Related Standards" addrulepath="administrator/components/com_tjfields/models/rules" addfieldpath="administrator/components/com_tjfields/models/fields"><field name="com_tjucm_dfedigitalleadershipandgovernancestandards_clusterclusterid" type="cluster" label="organisation" description="" class="" validate="cluster"/><field name="com_tjucm_dfedigitalleadershipandgovernancestandards_NamedSLTDigitalLead" type="text" label="Named SLT Digital Lead" description="" class=""/><field name="com_tjucm_dfedigitalleadershipandgovernancestandards_RelatedStandards" type="freetext" label="Related Standards" description="" class="" freetext="&lt;h3&gt;&lt;span style=&quot;font-size: 1rem;&quot;&gt;The following standards should also be considered when documenting and monitoring your data, equipment, and systems.&lt;/span&gt;&lt;/h3&gt;&#13;&#10;&lt;h3&gt;&lt;br /&gt;&lt;span style=&quot;display: flex; align-items: center;&quot;&gt;&lt;img src=&quot;images/2024/DfE%20Digital%20Standards/bigDtransparent.png&quot; width=&quot;29&quot; height=&quot;29&quot; /&gt; &lt;span style=&quot;color: #000000;&quot;&gt;&lt;a href=&quot;best-practice-library/dfe-digital-standards/dfe-digital-standards-h/dfe-broadband-internet&quot; style=&quot;color: #000000;&quot;&gt;&lt;span style=&quot;margin-left: 4px;&quot;&gt;DfE&lt;/span&gt;&lt;span style=&quot;margin-left: 4px;&quot;&gt; Digital &lt;/span&gt;&lt;span style=&quot;margin-left: 4px;&quot;&gt;Standards&lt;/span&gt;&lt;span style=&quot;margin-left: 4px;&quot;&gt; DPE Trackers&lt;/span&gt;&lt;/a&gt;:&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;&#13;&#10;&lt;a href=&quot;best-practice-library/dfe-digital-standards/dfe-digital-standards-h/dfe-broadband-internet&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Broadband Internet Standards Tracker&lt;/a&gt;&lt;br /&gt;&lt;a href=&quot;best-practice-library/dfe-digital-standards/dfe-digital-standards-h/dfe-servers&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Servers &amp;amp; Storage Standards Tracker&lt;/a&gt;&lt;br /&gt;&lt;a href=&quot;best-practice-library/dfe-digital-standards/dfe-digital-standards-h/dfe-laptop&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Laptop, Desktop &amp;amp; Tablets Standards Tracker&lt;/a&gt;&lt;br /&gt;&lt;a href=&quot;best-practice-library/dfe-digital-standards/dfe-digital-standards-h/dfe-cloud&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Cloud Solutions Standards Tracker&lt;/a&gt;&lt;br /&gt;&lt;a href=&quot;best-practice-library/dfe-digital-standards/dfe-digital-standards-h/dfe-cybersecurity-slt&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Cyber Security Standards Tracker&lt;/a&gt;&lt;br /&gt;&lt;a href=&quot;best-practice-library/dfe-digital-standards/dfe-digital-standards-h/dfe-filtering&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Filtering &amp;amp; Monitoring Standards Tracker&lt;/a&gt;&lt;br /&gt;&lt;br /&gt;&lt;hr /&gt;&#13;&#10;&lt;h3&gt;DfE Digital Standards External Links:&lt;/h3&gt;&#13;&#10;Broadband internet standards&#13;&#10;&lt;ul&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/broadband-internet-standards-for-schools-and-colleges#schools-and-colleges-should-have-a-backup-broadband-connection-to-ensure-resilience-and-maintain-continuity-of-service&quot; data-ga4-index=&quot;{&amp;quot;index_link&amp;quot;: 1}&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot; style=&quot;font-size: 1rem;&quot;&gt;Schools and colleges should have a backup broadband connection to ensure resilience and maintain continuity of service&lt;/a&gt;&lt;span style=&quot;font-size: 1rem;&quot;&gt;&#xA0;&lt;/span&gt;&lt;/li&gt;&#13;&#10;&lt;/ul&gt;&#13;&#10;&lt;span style=&quot;display: flex; align-items: center;&quot;&gt; &lt;/span&gt; Servers and storage standards&#13;&#10;&lt;ul&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/servers-and-storage-standards-for-schools-and-colleges#servers-and-related-storage-platforms-must-be-secure-and-follow-data-protection-legislation&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Servers and related storage platforms must be secure and follow data protection legislation&lt;/a&gt;&lt;/li&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/servers-and-storage-standards-for-schools-and-colleges#all-server-and-related-storage-platforms-should-be-kept-and-used-in-an-appropriate-physical-environment&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;All server and related storage platforms should be kept and used in an appropriate physical environment&lt;/a&gt;&lt;/li&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/servers-and-storage-standards-for-schools-and-colleges#servers-and-related-storage-platforms-must-be-secure-and-follow-data-protection-legislation&quot; data-ga4-index=&quot;{&amp;quot;index_link&amp;quot;: 8}&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Servers and related storage platforms must be secure and follow data protection legislation&lt;/a&gt;&lt;/li&gt;&#13;&#10;&lt;/ul&gt;&#13;&#10;&lt;p&gt;Laptops, desktops, and tablets standards&lt;/p&gt;&#13;&#10;&lt;ul&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/laptop-desktop-and-tablet-standards#devices-should-meet-educational-needs-and-support-the-digital-technology-strategy&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Devices should meet educational needs and support the digital technology strategy&lt;/a&gt;&lt;/li&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/laptop-desktop-and-tablet-standards#make-sure-devices-are-energy-efficient-and-they-are-bought-and-disposed-of-sustainably&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Make sure devices are energy efficient, and they are bought and disposed of sustainably&lt;/a&gt;&lt;/li&gt;&#13;&#10;&lt;/ul&gt;&#13;&#10;&lt;p id=&quot;cloud-solution-standards&quot;&gt;&lt;br /&gt;Cloud solution standards&#xA0;&lt;/p&gt;&#13;&#10;&lt;ul&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/cloud-solution-standards-for-schools-and-colleges#make-sure-that-appropriate-data-backup-provision-is-in-place&quot; data-ga4-index=&quot;{&amp;quot;index_link&amp;quot;: 3}&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Make sure that appropriate data backup provision is in place&lt;/a&gt;&#xA0;&lt;/li&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/cloud-solution-standards-for-schools-and-colleges#cloud-solutions-must-follow-data-protection-legislation&quot; data-ga4-index=&quot;{&amp;quot;index_link&amp;quot;: 4}&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Cloud solutions must follow data protection legislation&lt;/a&gt;&#xA0;&lt;/li&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/cloud-solution-standards-for-schools-and-colleges#cloud-solutions-should-use-id-and-access-management-tools&quot; data-ga4-index=&quot;{&amp;quot;index_link&amp;quot;: 5}&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Cloud solutions should use ID and access management tools&lt;/a&gt;&#xA0;&lt;/li&gt;&#13;&#10;&lt;/ul&gt;&#13;&#10;&#xA0; &lt;span style=&quot;font-size: 1rem;&quot;&gt;Cyber security standards&lt;/span&gt;&#13;&#10;&lt;ul&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/cyber-security-standards-for-schools-and-colleges#network-devices-should-be-known-and-recorded-with-their-security-features-enabled-correctly-configured-and-kept-up-to-date&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Network devices should be known and recorded with their security features enabled, correctly configured and kept up-to-date&lt;/a&gt;&lt;/li&gt;&#13;&#10;&lt;li&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/cyber-security-standards-for-schools-and-colleges#your-business-continuity-and-disaster-recovery-plan-should-include-a-regularly-tested-contingency-plan-in-response-to-a-cyber-attack&quot; data-ga4-index=&quot;{&amp;quot;index_link&amp;quot;: 2}&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Your business continuity and disaster recovery plan should include a regularly tested contingency plan in response to a cyber attack&lt;/a&gt;&lt;/li&gt;&#13;&#10;&lt;/ul&gt;&#13;&#10;&lt;p id=&quot;filtering-and-monitoring-standards&quot;&gt;Filtering and monitoring standards&#xA0;&lt;/p&gt;&#13;&#10;&lt;ul&gt;&#13;&#10;&lt;li&gt;&#13;&#10;&lt;p&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/filtering-and-monitoring-standards-for-schools-and-colleges#your-filtering-system-should-block-harmful-and-inappropriate-content-without-unreasonably-impacting-teaching-and-learning&quot; data-ga4-index=&quot;{&amp;quot;index_link&amp;quot;: 6}&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Your filtering system should block harmful and inappropriate content, without unreasonably impacting teaching and learning&lt;/a&gt;&#xA0;&lt;/p&gt;&#13;&#10;&lt;/li&gt;&#13;&#10;&lt;li&gt;&#13;&#10;&lt;p&gt;&lt;a href=&quot;https://www.gov.uk/guidance/meeting-digital-and-technology-standards-in-schools-and-colleges/filtering-and-monitoring-standards-for-schools-and-colleges#you-should-have-effective-monitoring-strategies-that-meet-the-safeguarding-needs-of-your-school-or-college&quot; data-ga4-index=&quot;{&amp;quot;index_link&amp;quot;: 7}&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;You should have effective monitoring strategies that meet the safeguarding needs of your school or college&lt;/a&gt;&#xA0;&lt;/p&gt;&#13;&#10;&lt;/li&gt;&#13;&#10;&lt;/ul&gt;"/><field name="com_tjucm_dfedigitalleadershipandgovernancestandards_Adigitallinkrolewithinthegoverningbodyorboardoftrusteeshasbeenassigned" type="radio" label="A digital link role within the governing body or board of trustees has been assigned" description="" class=""><option value="10">yes</option><option value="0">no</option></field><field name="com_tjucm_dfedigitalleadershipandgovernancestandards_Doesitcapturethevalueofcontracts" type="radio" label="Does it capture the value of contracts?" description="" class=""><option value="10">Yes</option><option value="0">No</option></field><field name="com_tjucm_dfedigitalleadershipandgovernancestandards_testpercentage" type="numericcalculation" label="test percentage" description="" class="" calculationfield="{com_tjucm_dfedigitalleadershipandgovernancestandards_Adigitallinkrolewithinthegoverningbodyorboardoftrusteeshasbeenassigned + com_tjucm_dfedigitalleadershipandgovernancestandards_Doesitcapturethevalueofcontracts&#9;}" colorcombination="{&#13;&#10;    &quot;1&quot;: {&#13;&#10;        &quot;color&quot;: &quot;#FF0000&quot;,&#13;&#10;        &quot;value&quot;: &quot;0% | No questions completed | Not meeting the standard&quot;,&#13;&#10;        &quot;min&quot;: &quot;0&quot;,&#13;&#10;        &quot;max&quot;: &quot;0.1&quot;&#13;&#10;    },&#13;&#10; &#13;&#10;    &quot;2&quot;: {&#13;&#10;        &quot;color&quot;: &quot;#e6ad02&quot;,&#13;&#10;        &quot;value&quot;: &quot;11.1% | 1/9 questions completed | Partially meeting the standard&quot;,&#13;&#10;        &quot;min&quot;: &quot;1&