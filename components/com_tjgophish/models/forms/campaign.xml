<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="general" addrulepath="administrator/components/com_tjgophish/models/rules" addfieldpath="/administrator/components/com_tjgophish/models/fields">
		<field name="gophish_campaign_title" type="text" required="true" class="input-large" label="COM_TJGOPHISH_CAMPAIGN_TITLE_LBL" description="COM_TJGOPHISH_CAMPAIGN_TITLE_DESC" />
		<field name="cluster_id" type="cluster" validate="cluster" required="true" label="COM_TJGOPHISH_CAMPAIGN_CLUSTER_LBL" description="COM_TJGOPHISH_CAMPAIGN_CLUSTER_DESC" />
		<field name="gophish_email_template" type="gophishemailtemplates" required="true" class="input-large" label="COM_TJGOPHISH_CAMPAIGN_EMAIL_TEMPLATE_LBL" description="COM_TJGOPHISH_CAMPAIGN_EMAIL_TEMPLATE_DESC" />
		<field name="gophish_landing_page" type="hidden" class="input-large" label="COM_TJGOPHISH_CAMPAIGN_LANDING_PAGE_LBL" description="COM_TJGOPHISH_CAMPAIGN_LANDING_PAGE_DESC" />

		<field name="gophish_campaign_launch_date" type="calendar" label="COM_TJGOPHISH_CAMPAIGN_LAUNCH_DATE_LBL" description="COM_TJGOPHISH_CAMPAIGN_LAUNCH_DATE_DESC" required="true" class="dpeCalender calendar-textfield-class" size="22" format="%d-%m-%Y %H:%M" showtime="true" translateformat="false" weeknumbers="false" filter="user_utc"/>

		<field name="gophish_sending_profile" type="hidden" class="input-large" label="COM_TJGOPHISH_CAMPAIGN_SENDING_PROFILE_LBL" description="COM_TJGOPHISH_CAMPAIGN_SENDING_PROFILE_DESC" />
		<field name="gophish_groups" type="gophishgroups" clusterAware="true" clusterField="cluster_id" required="true" multiple="true" class="input-large" label="COM_TJGOPHISH_CAMPAIGN_GROUPS_LBL" description="COM_TJGOPHISH_CAMPAIGN_GROUPS_DESC" />
		<field name="gophish_campaign_id" type="hidden" class="readonly" size="11" readonly="true" />
		<field name="id" type="hidden" class="readonly" size="11" readonly="true" />
		<field name="checked_out" type="hidden" filter="unset" />
		<field name="checked_out_time" type="hidden" filter="unset" />
		<field name="created_by" type="hidden" filter="unset" />
		<field name="created_date" type="hidden" filter="unset" />
		<field name="modified_by" type="hidden" filter="unset" />
		<field name="modified_date" type="hidden" filter="unset" />
	</fieldset>
</form>
