<?xml version="1.0" encoding="utf-8"?>
<form>
<fieldset addfieldpath="/administrator/components/com_tjcompetency/models/fields">
	<fields name="filter">

		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FILTER_SEARCH_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FILTER_SEARCH_LABEL_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="client"
			type="CompetencyContentTypes"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FILTER_CONTENT_TYPE_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FILTER_CONTENT_TYPE_DESC"
			useinfilter="true"
			onchange="this.form.submit();"
			class="multipleContentTypes"
			multiple="false"
		/>

		<field
			name="skill_id"
			type="skilledit"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FILTER_SKILL_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FILTER_SKILL_DESC"
			onchange="this.form.submit();"
			multiple="true"
			class="multipleSkills"
			hide_root="true"
			state="1"
		/>

		<field
			name="scale_id"
			type="scales"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FILTER_SCALE_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FILTER_SCALE_DESC"
			onchange="this.form.submit();"
			multiple="true"
			class="multipleScales"
		/>

	</fields>

	<fields name="list">

		<field
			name="limit"
			type="limitbox"
			class="input-mini"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</fieldset>
</form>
