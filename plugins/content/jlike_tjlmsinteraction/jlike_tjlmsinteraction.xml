<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE install PUBLIC "-//Joomla! 1.5//DTD plugin 1.0//EN" "http://www.joomla.org/xml/dtd/1.5/plugin-install.dtd">
<extension version="3.0" type="plugin" group="content" method="upgrade">
	<name>PLG_CONTENT_JLIKE_TJLMSINTERACTION</name>
	<creationDate>1st Jan 2019</creationDate>
	<author>Techjoomla</author>
	<authorEmail>extensions@techjoomla.com</authorEmail>
	<authorUrl>https://techjoomla.com</authorUrl>
	<copyright>Copyright (C) 2014 - 2019 Techjoomla. All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<version>1.3.4</version>
	<description>PLG_CONTENT_JLIKE_TJLMSINTERACTION_DESC</description>
	<files>
		<filename plugin="jlike_tjlmsinteraction">jlike_tjlmsinteraction.php</filename>
	</files>
	<languages folder="language">
			<language tag="en-GB">en-GB.plg_content_jlike_tjlmsinteraction.ini</language>
			<language tag="en-GB">en-GB.plg_content_jlike_tjlmsinteraction.sys.ini</language>
	</languages>
	<!-- Fields for Joomla 1.8.x and onwards -->
	<config name="params">
		<fields name="params">
			<fieldset name="basic" label="PLG_CONTENT_JLIKE_TJLMSINTERACTION_PARAMETER">
				<field
					name="allow_interaction"
					type="radio"
					default="1"
					label="PLG_CONTENT_JLIKE_TJLMSINTERACTION_FOR_LESSON"
					description="PLG_CONTENT_JLIKE_TJLMSINTERACTION_FOR_LESSON_DESC"
					class="btn-group">
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
