<?xml version="1.0" encoding="utf-8"?>
<extension version="3.0" type="plugin" group="content" method="upgrade">
    <name>PLG_CONTENT_JLIKE_COMMENT</name>
	<author>Techjoomla</author>
        <copyright>Copyright © 2018-2019 TechJoomla. All rights reserved.</copyright>
	<authorEmail>extensions@techjoomla.com</authorEmail>
	<authorUrl>http://www.techjoomla.com</authorUrl>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<creationDate>27th Dec 2018</creationDate>
	<version>2.1.3</version>
		<description>PLG_CONTENT_JLIKE_COMMENT_DESC</description>
        <files>
		<filename plugin="jlike_comment">jlike_comment.php</filename>
    	</files>
    	<languages folder="language">
			<language tag="en-GB">en-GB/en-GB.plg_content_jlike_comment.ini</language>
			<language tag="en-GB">en-GB/en-GB.plg_content_jlike_comment.sys.ini</language>
		</languages>
		<config>
			<fields name="params">
				<fieldset name="basic">
					<field name="public_comments" type="radio" class="btn-group" label="PLG_ALLOW_PUBLIC_COMMENT" default="1" description="PLG_ALLOW_COMMENT_PUBLIC_DESC">
						<option value="1">COMMENT_YES</option>
						<option value="0">COMMENT_NO</option>
					</field>
					<field name="private_comments" type="radio" class="btn-group" label="PLG_ALLOW_PRIVATE_COMMENT" default="1" description="PLG_ALLOW_PRIVATE_COMMENT_DESC">
						<option value="1">COMMENT_YES</option>
						<option value="0">COMMENT_NO</option>
					</field>
					<field name="comment_access" type="radio" class="btn-group" label="PLG_COMMENT_ACCESS" default="api" description="PLG_COMMENT_ACCESS_DESC">
						<option value="task">COMMENT_TASK</option>
						<option value="api">COMMENT_API</option>
					</field>
				</fieldset>
			</fields>
		</config>
</extension>
