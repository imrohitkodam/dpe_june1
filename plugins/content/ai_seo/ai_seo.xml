<field name="article_length" type="text" default="1500-2500" label="PLG_CONTENT_AI_SEO_ARTICLE_LENGTH_LABEL" description="PLG_CONTENT_AI_SEO_ARTICLE_LENGTH_DESC" />

<field name="dry_run" type="radio" default="1" label="PLG_CONTENT_AI_SEO_DRY_RUN_LABEL" description="PLG_CONTENT_AI_SEO_DRY_RUN_DESC">
<option value="1">JYES</option><option value="0">JNO</option>
</field>
<field name="max_keywords" type="number" default="10" label="PLG_CONTENT_AI_SEO_MAX_KEYWORDS_LABEL" description="PLG_CONTENT_AI_SEO_MAX_KEYWORDS_DESC" />
