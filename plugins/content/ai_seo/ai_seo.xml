</field>
<field name="enabled_content_rewrite" type="radio" default="1" label="PLG_CONTENT_AI_SEO_ENABLED_REWRITE_LABEL" description="PLG_CONTENT_AI_SEO_ENABLED_REWRITE_DESC">
