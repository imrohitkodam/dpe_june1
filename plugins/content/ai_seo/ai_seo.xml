    <option value="openai" label="PLG_CONTENT_AI_SEO_OPTION_OPENAI" />
    <option value="claude" label="PLG_CONTENT_AI_SEO_OPTION_CLAUDE" />
    <option value="gemini" label="PLG_CONTENT_AI_SEO_OPTION_GEMINI" />
</field>

