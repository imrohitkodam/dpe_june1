    <option value="claude-3-sonnet-20240229" label="PLG_CONTENT_AI_SEO_MODEL_CLAUDE_3_SONNET" />
    <option value="claude-3-haiku-20240307" label="PLG_CONTENT_AI_SEO_MODEL_CLAUDE_3_HAIKU" />
</field>

