</field>

<!-- Other Settings -->
<field name="enabled_keywords" type="radio" default="1" label="PLG_CONTENT_AI_SEO_ENABLED_KEYWORDS_LABEL" description="PLG_CONTENT_AI_SEO_ENABLED_KEYWORDS_DESC">
<option value="1">JYES</option>
<option value="0">JNO</option>
</field>
<field name="enabled_meta_title" type="radio" default="0" label="PLG_CONTENT_AI_SEO_ENABLED_META_TITLE_LABEL" description="PLG_CONTENT_AI_SEO_ENABLED_META_TITLE_DESC">
<option value="1">JYES</option><option value="0">JNO</option>
</field>
<field name="enabled_meta_description" type="radio" default="0" label="PLG_CONTENT_AI_SEO_ENABLED_META_DESC_LABEL" description="PLG_CONTENT_AI_SEO_ENABLED_META_DESC_DESC">
<option value="1">JYES</option><option value="0">JNO</option>
</field>
<field name="enabled_summary_field" type="radio" default="0" label="PLG_CONTENT_AI_SEO_ENABLED_SUMMARY_LABEL" description="PLG_CONTENT_AI_SEO_ENABLED_SUMMARY_DESC">
