<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="assignments">
		<!-- Article -->
		<fieldset name="single">
			<fields name="dpcalendarsingle">
				<field name="assignment_state" type="assignmentselection" 
					label="Event"
					description="PLG_GSD_DPCALENDAR_ASSIGN_EVENT_DESC"
				/>
				<field name="selection" type="componentitems" 
					label="NR_SELECTION" 
					description="PLG_GSD_DPCALENDAR_ASSIGN_EVENT_SELECTION_DESC"
					multiple="true"
					table="dpcalendar_events"
					column_state="state"
				/>
        	</fields>
    	</fieldset>
		<!-- Category -->
		<fieldset name="category">
			<fields name="dpcalendarcategory">
				<field name="assignment_state" type="assignmentselection"
	                label="NR_CATEGORIES"
	                description="PLG_GSD_DPCALENDAR_ASSIGN_CATEGORY_DESC"
	            />
	            <field name="selection" type="tfdpcalendarcategories" 
	                label="NR_SELECTION" 
	                description="NR_CATEGORIES_DESC"
	                multiple="true" 
	            />
	            <fields name="params">
		            <field name="inc_children" type="list"
		                label="NR_ALSO_ON_CHILD_ITEMS"
		                description="NR_ALSO_ON_CHILD_ITEMS_DESC"
		             	class="input-medium"
		                default="0">
		                <option value="0">JNO</option>
		                <option value="1">JYES</option>
		                <option value="2">NR_ONLY</option>
		            </field>
	        	</fields>
        	</fields>
    	</fieldset>
	</fields>
</form>