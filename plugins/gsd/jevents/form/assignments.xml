<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="assignments">
		<!-- Single -->
		<fieldset name="single">
			<fields name="jeventssingle">
				<field name="assignment_state" type="assignmentselection" 
					label="GSD_EVENT"
					description="PLG_GSD_JEVENTS_ASSIGN_ITEM_DESC"
				/>
				<field name="selection" type="componentitems" 
					label="NR_SELECTION" 
					description="PLG_GSD_JEVENTS_ASSIGN_ITEM_SELECTION_DESC"
					multiple="true"
					table="jevents_vevent"
					column_id="ev_id"
					column_title="c.summary"
					column_state="state"
					join="#__jevents_vevdetail as c ON i.ev_id = c.evdet_id"
				/>
        	</fields>
    	</fieldset>
		<!-- Category -->
		<fieldset name="category">
			<fields name="jeventscategory"> 
	            <field name="assignment_state" type="assignmentselection"
	                label="NR_CATEGORIES"
	                description="PLG_GSD_JEVENTS_ASSIGN_CATEGORY_DESC"
	            />
	            <field name="selection" type="NRJEventsCategories"
	                label="NR_SELECTION" 
	                description="NR_CATEGORIES_DESC"
	                group="categories" 
	                multiple="true" 
	            />
	            <fields name="params">
		            <field name="inc_children" type="list"
		                label="NR_ALSO_ON_CHILD_ITEMS"
		                description="NR_ALSO_ON_CHILD_ITEMS_DESC"
		             	class="input-medium"
		                default="0">
		                <option value="0">JNO</option>
		                <option value="1">JYES</option>
		                <option value="2">NR_ONLY</option>
		            </field>
	        	</fields>
        	</fields>
    	</fieldset>
	</fields>
</form>