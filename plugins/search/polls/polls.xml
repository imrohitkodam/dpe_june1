<?xml version="1.0" encoding="utf-8" standalone="no"?>
<extension group="search" method="upgrade" type="plugin" version="3.0">
	<name>Search - Community Polls</name>
	<creationDate>2018-Apr-01</creationDate>
	<author>Maverick</author>
	<authorEmail>support@corejoomla.com</authorEmail>
	<authorUrl>http://www.corejoomla.com</authorUrl>
	<copyright>Copyright (C) Copyright © 2009 - 2012 corejoomla.com. All rights reserved.</copyright>
	<license>http://www.corejoomla.com GNU/GPL</license>
	<version>4.6.5</version>
	<description>Search Community Polls</description>
	<files>
		<filename plugin="polls">polls.php</filename>
	</files>
	<languages folder="language/en-GB">
		<language tag="en-GB">en-GB.plg_search_polls.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				 <field default="50" description="PLG_SEARCH_POLLS_FIELD_SEARCHLIMIT_DESC" label="PLG_SEARCH_POLLS_FIELD_SEARCHLIMIT_LABEL" name="search_limit" size="5" type="text"/>

				<field class="btn-group btn-group-yesno" default="0" description="PLG_SEARCH_POLLS_FIELD_CONTENT_DESC" label="PLG_SEARCH_POLLS_FIELD_CONTENT_LABEL" name="search_polls" type="radio">
					<option value="1">JON</option>
					<option value="0">JOFF</option>
				</field>

				<field class="btn-group btn-group-yesno" default="0" description="PLG_SEARCH_POLLS_FIELD_ARCHIVED_DESC" label="PLG_SEARCH_POLLS_FIELD_ARCHIVED_LABEL" name="search_archived" type="radio">
					<option value="1">JON</option>
					<option value="0">JOFF</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
