<?xml version="1.0" encoding="utf-8"?>
<extension version="2.5" type="plugin" group="finder" method="upgrade">
	<identifier>plg:finder.docman</identifier>
    <name>plg_finder_docman</name>
    <author>Joomlatools</author>
    <creationDate>April 2025</creationDate>
    <copyright>Copyright (C) 2011 Timble CVBA</copyright>
    <license>GNU GPLv3 - http://www.gnu.org/licenses/gpl.html</license>
    <authorEmail>info@joomlatools.eu</authorEmail>
    <authorUrl>www.joomlatools.eu</authorUrl>
	<version>6.0.1</version>
	<description />

	<files>
		<filename plugin="docman">docman.php</filename>
        <folder>language</folder>
	</files>
	<config>
		<fields name="params">
            <fieldset name="basic">
                <field name="show_author" type="radio" class="btn-group" default="0" label="SHOW_AUTHOR_DESCRIPTION">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="show_category" type="radio" class="btn-group" default="0" label="SHOW_CATEGORY_DESCRIPTION">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
			</fieldset>
		</fields>
	</config>
</extension>
