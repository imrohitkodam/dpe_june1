               default="25"
               label="MOD_SEARCHAJAX_FIELD_RESULTLIMIT"
               description="MOD_SEARCHAJAX_FIELD_RESULTLIMIT_DESC" />
            <field
               name="perpage_limit"
               type="number"
               default="5"
               label="MOD_SEARCHAJAX_FIELD_PERPAGE"
               description="MOD_SEARCHAJAX_FIELD_PERPAGE_DESC" />
            <field
