               <option value="0">JNO</option>               
            </field>
            <field name="search_page_link" type="text" default="" label="MOD_SEARCHIN_SEARCH_PAGE_URL" description="MOD_SEARCHIN_SEARCH_PAGE_URL_DESC" showon="redirect_search_url:1" />
			<field name="joomla_version" type="joomlaversion" class="joomla_version" label="Joomla Version" description=""  />
