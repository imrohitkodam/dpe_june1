                <option value="k2_description">MOD_SEARCHAJAX_DESCRIPTION</option>
                <option value="k2_category">MOD_SEARCHAJAX_CATEGORY</option>
                <option value="k2_tags">MOD_SEARCHAJAX_TAGS</option>
            </field>
            <field name="k2catid" type="k2categories" label="MOD_SEARCHAJAX_FIELD_CATEGORY_K2" description="MOD_SEARCHAJAX_FIELD_CATEGORY_DESC" showon="search_in_k2:1" />
