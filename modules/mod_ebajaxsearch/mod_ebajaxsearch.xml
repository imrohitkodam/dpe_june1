                <option value="pc_features">MOD_SEARCHAJAX_LONG_FEATURES</option>
                <option value="pc_category">MOD_SEARCHAJAX_CATEGORY</option>
                <option value="pc_tag">MOD_SEARCHAJAX_TAGS</option>
