				<option value="dj_description">MOD_SEARCHAJAX_LONG_DESCRIPTION</option>
				<option value="dj_category">MOD_SEARCHAJAX_CATEGORY</option>
				<option value="dj_tag">MOD_SEARCHAJAX_TAGS</option>
			
			</field>			
			<field name="djcatid" type="djeventscategories" label="MOD_SEARCHAJAX_FIELD_CATEGORY_DJ_EVENTS" description="MOD_SEARCHAJAX_FIELD_CATEGORY_DESC" showon="search_in_dj:1" />								
