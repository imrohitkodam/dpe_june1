            </field>
            <field name="pccatid" type="pccategories" label="MOD_SEARCHAJAX_FIELD_CATEGORY_PHOCACART" description="MOD_SEARCHAJAX_FIELD_CATEGORY_DESC" showon="search_in_pc:1" />					
			
