               <option value="manual">MOD_SEARCHAJAX_FIELD_BUTTON_MANUAL</option>
            </field>
            <field
               name="button_manual_width"
               type="text"
               label="MOD_SEARCHAJAX_FIELD_BUTTONTEXT_WIDTH"
               description="MOD_SEARCHAJAX_FIELD_BUTTONTEXT_WIDTH_DESC"
               default="85"
               showon="button:1[AND]button_size:manual" />
            <field
               name="button_manual_height"
               type="text"
               label="MOD_SEARCHAJAX_FIELD_BUTTONTEXT_HEIGHT"
               description="MOD_SEARCHAJAX_FIELD_BUTTONTEXT_WIDTH_DESC"
               default="36"
               showon="button:1[AND]button_size:manual" />
            <field
               name="by_ordering"
               type="radio"
               default="0"
               class="btn-group btn-group-yesno"
               label="MOD_SEARCHAJAX_FIELD_BUTTON_LABEL"
               description="MOD_SEARCHAJAX_FIELD_BUTTON_DESC">
               <option value="1">JYES</option>
               <option value="0">JNO</option>
            </field>
            <field name="by_ordering" type="list" label="MOD_SEARCHAJAX_ORDERING" >
                <option value="newest">MOD_SEARCHAJAX_NF</option>
                <option value="oldest">MOD_SEARCHAJAX_OF</option>
                <option value="popular">MOD_SEARCHAJAX_MP</option>
                <option value="alpha">MOD_SEARCHAJAX_PLPHA</option>
            </field>
            <field
               name="trigger_search_characters"
               type="number"
               default="3"
               label="MOD_SEARCHAJAX_FIELD_TRIDDER_CHAR"
               description="MOD_SEARCHAJAX_FIELD_TRIDDER_CHAR_DESC" />
            <field
               name="result_limit"
