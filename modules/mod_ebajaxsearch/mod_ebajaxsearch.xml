			   <option value="docman_description">MOD_SEARCHAJAX_DESCRIPTION</option>
			   <option value="docman_category">MOD_SEARCHAJAX_CATEGORY</option>
		   </field>
		   
		   <field name="docmanmenu" type="menuitem" default="101" label="MOD_SEARCHAJAX_FIELD_DOCMAN_MENU_SELELCT_LABLE" description="MOD_SEARCHAJAX_FIELD_DOCMAN_MENU_SELELCT_DESC" showon="search_in_docman:1" />
		   
		   <field name="docmancatid" type="docmancategories" label="MOD_SEARCHAJAX_FIELD_CATEGORY_DOCMAN" description="MOD_SEARCHAJAX_FIELD_CATEGORY_DESC" showon="search_in_docman:1" />		
		   
		   <field
               name="label"
               type="label"
               label="MOD_SEARCH_FIELD_LABEL_TEXT_LABEL" />
            <field
               name="width"
               type="text"
               label="MOD_SEARCHAJAX_FIELD_BOXWIDTH_LABEL"
               description="MOD_SEARCHAJAX_FIELD_BOXWIDTH_DESC" />
            <field
               name="text"
               type="text"
               label="MOD_SEARCHAJAX_FIELD_TEXT_LABEL" />
            <field
               name="button"
               type="radio"
               default="0"
               class="btn-group btn-group-yesno"
               label="MOD_SEARCHAJAX_FIELD_BUTTON_LABEL"
               description="MOD_SEARCHAJAX_FIELD_BUTTON_DESC">
               <option value="1">JYES</option>
               <option value="0">JNO</option>
            </field>
			<field
               name="button_background_color"
               type="color"
               label="MOD_SEARCHAJAX_FIELD_BUTTON_BG_COLOR"
			   showon="button:1" />
            <field
               name="button_text_color"
               type="color"
               label="MOD_SEARCHAJAX_FIELD_BUTTON_TEXT_COLOR" 
			   showon="button:1" />
            <field
               name="button_text"
               type="text"
               label="MOD_SEARCHAJAX_FIELD_BUTTONTEXT_LABEL"
               description="MOD_SEARCHAJAX_FIELD_BUTTONTEXT_DESC"
               showon="button:1" />           
            <field
               name="button_size"
               type="radio"
               default="auto"
               class="btn-group"
               label="MOD_SEARCHAJAX_FIELD_BUTTON_WIDTH"
               showon="button:1"
