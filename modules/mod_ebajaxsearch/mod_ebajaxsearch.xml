			   showon="search_in_vm:1"
			   >               
               <option value="1">JYES</option>
               <option value="0">JNO</option>               
            </field>
			
            <field name="search_vm_fields" label="MOD_SEARCHAJAX_SEARCH_FIELDS" type="checkboxes" default="vm_title,vm_description" showon="search_in_vm:1">
                <option value="vm_title">MOD_SEARCHAJAX_TITLE</option>
                <option value="vm_description">MOD_SEARCHAJAX_DESCRIPTION</option>
                <option value="vm_category">MOD_SEARCHAJAX_CATEGORY</option>
            </field>
            <field name="vmcatid" type="vmcategories" label="MOD_SEARCHAJAX_FIELD_CATEGORY_VIRTUEMART" description="MOD_SEARCHAJAX_FIELD_CATEGORY_DESC" showon="search_in_vm:1" />
