    <config>
      <fields name="params" addfieldpath="/modules/mod_ebajaxsearch/elements/">
         <fieldset name="basic">
			<field
               name="search_in_article"
               type="radio"
               default="1"
               class="btn-group btn-group-yesno"
               label="MOD_SEARCHIN_ARTICLE"
               description="MOD_SEARCHIN_ARTICLE_INFO">               
               <option value="1">JYES</option>
               <option value="0">JNO</option>               
            </field>
            <field name="search_article_fields" label="MOD_SEARCHAJAX_SEARCH_FIELDS" type="checkboxes" default="sf_title,sf_description" showon="search_in_article:1">
                <option value="sf_title">MOD_SEARCHAJAX_TITLE</option>
                <option value="sf_description">MOD_SEARCHAJAX_DESCRIPTION</option>
                <option value="sf_category">MOD_SEARCHAJAX_CATEGORY</option>
                <option value="sf_customfield">MOD_SEARCHAJAX_CUSTOM_FIELD</option>
                <option value="sf_tags">MOD_SEARCHAJAX_TAGS</option>
            </field>
            <field
               name="catid"
               type="category"
               label="MOD_SEARCHAJAX_FIELD_CATEGORY"
               description="MOD_SEARCHAJAX_FIELD_CATEGORY_DESC"
               extension="com_content"
               multiple="true"
               filter="int_array"
               class="multipleCategories"
               showon="search_in_article:1"
            />
            <field
               name="search_in_k2"
               type="radio"
               default="0"
               class="btn-group btn-group-yesno"
