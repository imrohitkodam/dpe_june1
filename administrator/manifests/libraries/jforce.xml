	<creationDate>February 2014</creationDate>
	<copyright>Copyright (C) 2014 JoomlaForce Team. All rights reserved.</copyright>
	<license>GNU General Public License version 3 or later</license>
	<authorEmail>support@joomlaforce.com</authorEmail>
	<authorUrl>JoomlaForce.com</authorUrl>
	<version>1.1.8</version>
	<description>Library needed for Joomla Force extensions</description> 
	<media folder="media" destination="jforce">
