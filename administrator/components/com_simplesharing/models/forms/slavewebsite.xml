<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset>

        <field name="id" type="text" default="0" label="COM_SIMPLESHARING_FORM_LBL_SLAVEWEBSITE_ID"
               readonly="true" class="readonly"
               description="JGLOBAL_FIELD_ID_DESC" /> 

        <field name="website_name" type="text"
                
               label="COM_SIMPLESHARING_FORM_LBL_SLAVEWEBSITE_WEBSITE_NAME"
               description="COM_SIMPLESHARING_FORM_DESC_SLAVEWEBSITE_WEBSITE_NAME" 
                
                
               required="true" 
               menu_published="0"
               filter="raw"
               size="50"
               maxlength="255" /> 

        <field name="website_url" type="text"
                
               label="COM_SIMPLESHARING_FORM_LBL_SLAVEWEBSITE_WEBSITE_URL"
               description="COM_SIMPLESHARING_FORM_DESC_SLAVEWEBSITE_WEBSITE_URL" 
               message="COM_SIMPLESHARING_FORM_SLAVEWEBSITE_WEBSITE_URL_VALIDATION_ERROR"    
                
               required="true" 
               filter="url"
               size="50" /> 

        <field name="admin_username" type="text"
                
               label="COM_SIMPLESHARING_FORM_LBL_SLAVEWEBSITE_ADMIN_USERNAME"
               description="COM_SIMPLESHARING_FORM_DESC_SLAVEWEBSITE_ADMIN_USERNAME" 
                
                
               required="true" 
               size="50" /> 

        <field name="admin_password" type="password"
                
               label="COM_SIMPLESHARING_FORM_LBL_SLAVEWEBSITE_ADMIN_PASSWORD"
               description="COM_SIMPLESHARING_FORM_DESC_SLAVEWEBSITE_ADMIN_PASSWORD" 
                
                
               required="true"  /> 

        <field name="debug_mode" type="radio"
               default = "0"
               label="COM_SIMPLESHARING_FORM_LBL_SLAVEWEBSITE_DEBUG_MODE"
               description="COM_SIMPLESHARING_FORM_DESC_SLAVEWEBSITE_DEBUG_MODE"
               class="btn-group btn-group-yesno">
            <option value="0">Disable</option>
            <option value="1">Enable</option>
        </field>
        
        <field name="token" type="password"
                
               label="COM_SIMPLESHARING_FORM_LBL_SLAVEWEBSITE_TOKEN"
               description="COM_SIMPLESHARING_FORM_DESC_SLAVEWEBSITE_TOKEN" 
                
                
               required="true" 
               size="50" /> 

        <field name="created_by" type="createdby" default="" 
               label="COM_SIMPLESHARING_FORM_LBL_SLAVEWEBSITE_CREATED_BY"
               description="COM_SIMPLESHARING_FORM_DESC_SLAVEWEBSITE_CREATED_BY"  /> 

        <field
            name="state"
            type="list"
            label="JSTATUS"
            description="JFIELD_PUBLISHED_DESC"
            class="inputbox"
            size="1"
            default="1">
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field> 

        <field name="checked_out" type="hidden" filter="unset" />
        <field name="checked_out_time" type="hidden" filter="unset" />

    </fieldset>

</form>
