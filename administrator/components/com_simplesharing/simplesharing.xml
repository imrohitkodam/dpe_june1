<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="3.0" method="upgrade">
    <name>com_simplesharing</name>
    <creationDate>2017-04-15</creationDate>
    <copyright>Copyright (C) 2014-2017. All rights reserved.</copyright>
    <license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
    <author>NYC HelpDesk.co LLC</author>
    <authorEmail>support@nychelpdesk.co</authorEmail>
    <authorUrl>nychelpdesk.co</authorUrl>
    <version>1.0.38</version>
    <description>A component to allow sharing Joomla contents among joomla websites.</description>    
       
    <install> <!-- Runs on install -->
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall> <!-- Runs on uninstall -->
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>

    <files folder="site">
        <filename>index.html</filename>
        <filename>simplesharing.php</filename>
        <filename>controller.php</filename>
        <filename>router.php</filename>
        <folder>views</folder>
        <folder>models</folder>
        <folder>controllers</folder>
        <folder>helpers</folder>
        <folder>assets</folder>
    </files>
    <administration>
        <menu img="components/com_simplesharing/assets/images/s_com_simplesharing.png" >COM_SIMPLESHARING</menu>
        <submenu>
            
			<menu link="option=com_simplesharing&amp;view=slavewebsites" view="slavewebsites" img="components/com_simplesharing/assets/images/s_slavewebsites.png" alt="Simplesharing/Slavewebsites">COM_SIMPLESHARING_TITLE_SLAVEWEBSITES</menu>

			<menu link="option=com_simplesharing&amp;view=articles" view="articles" img="components/com_simplesharing/assets/images/s_articles.png" alt="Simplesharing/Articles">COM_SIMPLESHARING_TITLE_ARTICLES</menu>

        </submenu>
        <files folder="admin">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <filename>controller.php</filename>
            <filename>index.html</filename>
            <filename>simplesharing.php</filename>
            <folder>controllers</folder>
            <folder>assets</folder>
            <folder>helpers</folder>
            <folder>models</folder>
            <folder>sql</folder>
            <folder>tables</folder>
            <folder>views</folder>
            <folder>language</folder>
        </files>
        <updateservers>
		<server type="extension" name="Simple Sharing">http://joomla.box/simplesharing/ss_updates.xml</server>
	    </updateservers>
        <languages folder="admin">            
			<language tag="en-GB">language/en-GB/en-GB.com_simplesharing.ini</language>
			<language tag="en-GB">language/en-GB/en-GB.com_simplesharing.sys.ini</language>
        </languages>
    </administration>        
</extension>
