<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="1.0.0" method="upgrade">
    <name>com_advsearch</name>
    <creationDate>2013-01-11</creationDate>
    <copyright>Copyright (C) 2012. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <author>amol</author>
    <authorEmail>amol_p@tekdi.net</authorEmail>
    <version>1.0.0</version>
    <description></description>

    <install> <!-- Runs on install -->
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall> <!-- Runs on uninstall -->
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>

    <files folder="site">
        <filename>index.html</filename>
        <filename>advsearch.php</filename>
        <filename>controller.php</filename>
        <filename>router.php</filename>
        <folder>views</folder>
        <folder>models</folder>
        <folder>controllers</folder>
        <folder>helpers</folder>
        <folder>assets</folder>
        <folder>css</folder>
        <folder>js</folder>
    </files>

     <languages folder="site">
        <language tag="en-GB">language/en-GB.com_advsearch.ini
        </language>
    </languages>
    <administration>
        <menu img="components/com_advsearch/assets/images/l_searchindexer.jpg" >COM_ADVSEARCH</menu>
        <submenu>

			<menu link="option=com_advsearch&amp;view=searchindexer" view="searchindexer" img="components/com_advsearch/assets/images/l_searchindexer.jpg" alt="Advsearch/Searchindexer">COM_ADVSEARCH_TITLE_SEARCHINDEXER</menu>

        </submenu>
      <files folder="admin">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <filename>controller.php</filename>
            <filename>index.html</filename>
            <filename>advsearch.php</filename>
            <!--filename>advsearch.xml</filename-->
            <folder>controllers</folder>
            <folder>assets</folder>
            <folder>helpers</folder>
            <folder>models</folder>
            <folder>sql</folder>
            <folder>tables</folder>
            <folder>views</folder>
        </files>
         <languages folder="admin">
            <language tag="en-GB">language/en-GB.com_advsearch.ini
            </language>
            <language tag="en-GB">language/en-GB.com_advsearch.sys.ini
            </language>
        </languages>
   </administration>
</extension>

