<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset>
		<field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC" />
		<field name="ordering" />
		<field name="title" type="text" maxlength="255" filter="raw" required="true" label="COM_TJUCM_FORM_LBL_TYPE_TITLE" description="COM_TJUCM_FORM_DESC_TYPE_TITLE" hint="COM_TJUCM_FORM_LBL_TYPE_TITLE" />
		<field name="alias" type="text" class="inputbox" generator="title" label="COM_TJUCM_FORM_LBL_TYPE_ALIAS" description="COM_TJUCM_FORM_DESC_TYPE_ALIAS" hint="COM_TJUCM_FORM_LBL_TYPE_ALIAS" />
		<field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="type_description" type="textarea" cols="5" rows="5" label="COM_TJUCM_FORM_LBL_TYPE_TYPE_DESCRIPTION" description="COM_TJUCM_FORM_DESC_TYPE_TYPE_DESCRIPTION" hint="COM_TJUCM_FORM_LBL_TYPE_TYPE_DESCRIPTION" />
		<field name="unique_identifier" type="text" readonly="true" class="readonly" label="COM_TJUCM_FORM_LBL_TYPE_UNIQUE_IDENTIFIER" description="COM_TJUCM_FORM_DESC_TYPE_UNIQUE_IDENTIFIER" hint="COM_TJUCM_FORM_LBL_TYPE_UNIQUE_IDENTIFIER" />
		<field name="checked_out" type="hidden" filter="unset" />
		<field name="checked_out_time" default="0000-00-00 00:00:00" type="hidden" filter="unset" />
		<field name="created_by" type="createdby" default="0" label="COM_TJUCM_FORM_LBL_TYPE_CREATED_BY" description="COM_TJUCM_FORM_DESC_TYPE_CREATED_BY" hidden="true" hint="COM_TJUCM_FORM_LBL_TYPE_CREATED_BY" />
		<field name="created_date" type="timecreated" label="COM_TJUCM_FORM_LBL_TYPE_CREATED_DATE" description="COM_TJUCM_FORM_DESC_TYPE_CREATED_DATE" hidden="true" hint="COM_TJUCM_FORM_LBL_TYPE_CREATED_DATE" />
		<field name="modified_by" type="modifiedby" default="0" label="COM_TJUCM_FORM_LBL_TYPE_MODIFIED_BY" description="COM_TJUCM_FORM_DESC_TYPE_MODIFIED_BY" hidden="true" hint="COM_TJUCM_FORM_LBL_TYPE_MODIFIED_BY" />
		<field name="modified_date" type="timecreated" label="COM_TJUCM_FORM_LBL_TYPE_MODIFIED_DATE" description="COM_TJUCM_FORM_DESC_TYPE_MODIFIED_DATE" hidden="true" hint="COM_TJUCM_FORM_LBL_TYPE_MODIFIED_DATE" />
		<field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label" />
		<fields name="params" label="COM_TJUCM_FORM_LBL_TYPE_PARAMS" description="COM_TJUCM_FORM_DESC_TYPE_PARAMS" hint="COM_TJUCM_FORM_LBL_TYPE_PARAMS">
			<field name="is_subform" type="radio" class="btn-group" default="0" label="COM_TJUCM_FORM_LBL_TYPE_IS_SUBFORM" description="COM_TJUCM_FORM_DESC_TYPE_IS_SUBFORM" hint="COM_TJUCM_FORM_LBL_TYPE_IS_SUBFORM">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field name="allowed_count" type="number" label="COM_TJUCM_FORM_LBL_TYPE_ALLOWED_COUNT" description="COM_TJUCM_FORM_DESC_TYPE_ALLOWED_COUNT" hint="COM_TJUCM_FORM_LBL_TYPE_ALLOWED_COUNT" showon="is_subform:0" />
			<field name="allow_auto_save" type="radio" class="btn-group" default="1" label="COM_TJUCM_FORM_LBL_TYPE_ALLOW_AUTO_SAVE" description="COM_TJUCM_FORM_DESC_TYPE_ALLOW_AUTO_SAVE" hint="COM_TJUCM_FORM_LBL_TYPE_ALLOW_AUTO_SAVE" showon="is_subform:0">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field name="allow_draft_save" type="radio" class="btn-group" default="1" label="COM_TJUCM_FORM_LBL_TYPE_ALLOW_DRAFT_SAVE" description="COM_TJUCM_FORM_DESC_TYPE_ALLOW_DRAFT_SAVE" hint="COM_TJUCM_FORM_LBL_TYPE_ALLOW_DRAFT_SAVE" showon="allow_auto_save:0[AND]is_subform:0">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field name="publish_items" type="radio" class="btn-group" default="1" label="COM_TJUCM_FORM_LBL_TYPE_PUBLISH_ITEMS_BY_DEFAULT" description="COM_TJUCM_FORM_DESC_TYPE_PUBLISH_ITEMS_BY_DEFAULT" hint="COM_TJUCM_FORM_LBL_TYPE_PUBLISH_ITEMS_BY_DEFAULT">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field name="bitrate_on" type="radio" class="btn-group" default="0" label="COM_TJUCM_FORM_LBL_TYPE_ALLOW_BITRATE_ON" description="COM_TJUCM_FORM_DESC_LBL_TYPE_ALLOW_BITRATE_ON" hint="COM_TJUCM_FORM_LBL_TYPE_ALLOW_BITRATE_ON" showon="allow_auto_save:1[AND]is_subform:0">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<!-- DPE - hack - start -->
			<field name="note_enable" type="radio" class="btn-group" default="0" label="COM_TJUCM_FORM_LBL_TYPE_ALLOW_NOTE_ENABLE" description="COM_TJUCM_FORM_LBL_TYPE_ALLOW_NOTE_ENABLE_DESC">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field name="note_editor" type="editor" filter="raw" label="COM_TJUCM_FORM_LBL_TYPE_ALLOW_NOTE_EDITOR" description="" hint="COM_TJUCM_FORM_LBL_TYPE_NOTE_EDITOR" showon="note_enable:1"/>
			<!-- DPE - hack - end -->
			<field name="bitrate_seconds" type="number" filter="raw" label="COM_TJUCM_FORM_LBL_TYPE_BITRATE_SECONDS" description="COM_TJUCM_FORM_DESC_LBL_TYPE_BITRATE_SECONDS" hint="COM_TJUCM_FORM_LBL_TYPE_BITRATE_SECONDS" showon="bitrate_on:1"/>
			<field name="layout" type="componentlayout" label="COM_TJUCM_FORM_LBL_TYPE_LAYOUT" description="COM_TJUCM_FORM_DESC_TYPE_LAYOUT" useglobal="true" extension="com_tjucm" view="itemform" />
			<field name="details_layout" type="componentlayout" label="COM_TJUCM_DETAILS_LBL_TYPE_LAYOUT" description="COM_TJUCM_DETAILS_DESC_TYPE_LAYOUT" useglobal="true" extension="com_tjucm" view="item" />
			<field name="list_layout" type="componentlayout" label="COM_TJUCM_LIST_LBL_TYPE_LAYOUT" description="COM_TJUCM_LIST_DESC_TYPE_LAYOUT" useglobal="true" extension="com_tjucm" view="items" />
			<field name="ai_enable_insights" type="radio" class="btn-group" default="0" label="Enable AI Insights" description="Enable AI Insights integration for this UCM Type">
				<option value="0">JNo</option>
				<option value="1">JYes</option>
			</field>
			<field name="ai_prompt_template" type="textarea" cols="5" rows="5" default="Analyze the following UCM assessment data.

Generate:
1. Executive Summary
2. Key Findings
3. Risks Identified
4. Recommendations
5. Improvement Actions

Only use the provided information. Do not make assumptions." label="AI Prompt Template" description="Default prompt template used for AI generation" showon="ai_enable_insights:1" />
			<field name="ai_system_instruction" type="textarea" cols="5" rows="5" default="You are an assistant for this assessment form. You are strictly restricted to answering questions and providing analysis, summaries, or insights based *only* on the provided form data. If the user's query is not about this specific form or its contents, or asks you to perform unrelated tasks (e.g. general knowledge, writing code, translations of unrelated text, math problems, etc.), you must politely decline to answer, stating that you can only help with questions related to this specific assessment form. Do not make assumptions or use external knowledge." label="AI System Instruction" description="System instruction to guide AI behavior and restrict answers to form data only." showon="ai_enable_insights:1" />
			<field name="ai_allow_custom_prompt" type="radio" class="btn-group" default="0" label="Allow Custom Prompt" description="Allow users to modify prompts on the frontend" showon="ai_enable_insights:1">
				<option value="0">JNo</option>
				<option value="1">JYes</option>
			</field>
			<field name="ai_provider" type="list" default="gemini" label="AI Provider" description="Select the AI service provider" showon="ai_enable_insights:1">
				<option value="gemini">Google Gemini</option>
			</field>
			<field name="ai_show_button" type="radio" class="btn-group" default="1" label="Show AI Button" description="Display AI button on the frontend form view" showon="ai_enable_insights:1">
				<option value="0">JNo</option>
				<option value="1">JYes</option>
			</field>
			<field name="ai_enable_graph" type="radio" class="btn-group" default="0" label="Enable Graph Generation" description="Allow AI to generate charts and graphs" showon="ai_enable_insights:1">
				<option value="0">JNo</option>
				<option value="1">JYes</option>
			</field>
			<field name="ai_data_redaction" type="radio" class="btn-group" default="1" label="Data Redaction Enabled" description="Remove sensitive data (PII) before AI processing" showon="ai_enable_insights:1">
				<option value="0">JNo</option>
				<option value="1">JYes</option>
			</field>
			<field name="ai_pii_fields" type="piifields" multiple="true" label="Select PII Fields to Redact" description="Choose which fields contain sensitive PII data to be redacted/replaced before sending to AI" showon="ai_enable_insights:1[AND]ai_data_redaction:1" addfieldpath="administrator/components/com_tjucm/models/fields" />
			<field name="ai_disclaimer" type="textarea" cols="3" rows="3" default="Beta feature. AI-generated content is advisory and not authoritative." label="AI Disclaimer Text" description="Disclaimer text shown on the AI generation screen" showon="ai_enable_insights:1" />
			<field name="ai_max_tokens" type="number" default="2048" label="Max Tokens" description="Maximum token size for the AI model prompt" showon="ai_enable_insights:1" />
			<!-- DPE - hack - start -->
				<field name="type_options" type="textarea" cols="5" rows="5" label="COM_TJUCM_FORM_LBL_TYPE_PARAMS" description="COM_TJUCM_FORM_DESC_TYPE_PARAMS" hint="COM_TJUCM_FORM_DESC_TYPE_PARAMS" />
			<!-- DPE - hack - end -->
		</fields>
	</fieldset>
	<fieldset name="accesscontrol">
		<field name="asset_id" type="hidden" filter="unset" />
		<field name="rules" type="rules" label="JFIELD_RULES_LABEL" translate_label="false" filter="rules" validate="rules" class="inputbox" component="com_tjucm" section="type" />
	</fieldset>
</form>
administrator/components/com_tjucm/models/forms/type.xml