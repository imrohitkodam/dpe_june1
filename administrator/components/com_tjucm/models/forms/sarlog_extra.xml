;max&quot;: &quot;40&quot;&#13;&#10; &#9;}&#13;&#10; }"/><field name="com_tjucm_sarlog_dpechecklist" type="dpechecklist" label="dpe checklist" description="" class=""/><field name="com_tjucm_sarlog_Termandcondition" type="radio" label="Term and condition" description="" class="" default="Yes" showFeedbackOnForm="1"><option value="Yes">Yes</option><option value="No">No</option></field></fieldset><fieldset name="Pre-disclosure checklist" addrulepath="administrator/components/com_tjfields/models/rules" addfieldpath="administrator/components/com_tjfields/models/fields"><field name="com_tjucm_sarlog_Initialchecks" type="spacer" label="Initial checks" description="" class="" hr="false"/><field name="com_tjucm_sarlog_HastheDPObeenconsultedpriortodisclosure" type="tjlist" label="Has the DPO been consulted during this request?" description="" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option></field><field name="com_tjucm_sarlog_Hastheidentityoftherequesterbeenverified" type="tjlist" label="Has the identity of the requester been verified?" description="" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option><option value="Not necessary">Not necessary</option></field><field name="com_tjucm_sarlog_Hasaletterofacknolwedgementbeensent" type="tjlist" label="Has a letter of acknowledgement been sent?" description="" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option></field><field name="com_tjucm_sarlog_Hasthescopeoftherequestbeenconfirmed" type="tjlist" label="Has the scope of the request been confirmed?" description="Understanding what personal data is being asked for is important in providing an accurate response. It can also avoid a need for a second search if the data subject does not receive what they were expecting" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option><option value="Attempted - no response">Attempted - no response</option></field><field name="com_tjucm_sarlog_Predisclosurechecks" type="spacer" label="Pre-disclosure checks" description="" class="" hr="false"/><field name="com_tjucm_sarlog_Hasthedatabeencheckedbyanotherperson" type="tjlist" label="Has the data been checked by another person?" description="" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option></field><field name="com_tjucm_sarlog_Hasanynecessaryredactionbeencompleted" type="tjlist" label="Has any necessary redaction been completed?" description="Redaction involves permanently removing any data that relates to a third party that the data subjct is not entitled to see. For example this may include another child or parents' data " class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option></field><field name="com_tjucm_sarlog_HasthedisclosurebeencheckedbytheDPO" type="tjlist" label="Has the disclosure been checked by the DPO?" description="If you have any doubts or concerns about the disclose, contact your DPO" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option><option value="Not necessary">Not necessary</option></field><field name="com_tjucm_sarlog_Howwasthedisclosuremade" type="tjlist" label="How is information being disclosed to the data subject?" description="Always share the data in the most secure way possible" class=""><option value="">Select Option</option><option value="Physical collection/drop-off">Physical: collection/drop-off</option><option value="Physical secure mail/courier">Physical: secure mail/courier</option><option value="Electronic: secure email">Electronic: secure email</option><option value="Electronic: secure folder access">Electronic: secure folder access</option><option value="Other">Other</option></field><field name="com_tjucm_sarlog_Otherdisclosemethod" type="text" label="If other" description="" class="" default="Complete if other"/><field name="com_tjucm_sarlog_Hasasecuremethodofsharingthedatabeenagreed" type="tjlist" label="Has a secure method of sharing the data been agreed?" description="" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option></field><field name="com_tjucm_sarlog_Hasthedatabeingcopiedpriortodisclosure" type="tjlist" label="Has the disclosure been copied prior to disclosure?" description="" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option></field><field name="com_tjucm_sarlog_Hasanexplanatoryletterbeingsenttosupportthedisclosure" type="tjlist" label="Has an explanatory letter being sent to support the disclosure?" description="" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option></field><field name="com_tjucm_sarlog_Istherealogofthedatabeingdisclosed" type="tjlist" label="Is there a log of the data being disclosed?" description="" class=""><option value="">Select Option</option><option value="Yes">Yes</option><option value="No">No</option><option value="Don't know">Don't know</option></field></fieldset></form>
