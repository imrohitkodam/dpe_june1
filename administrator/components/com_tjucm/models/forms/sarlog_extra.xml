tails of request" description="" class="" rows="8" cols="28"/><field name="com_tjucm_sarlog_specialcategorydatainvolved" type="radio" label="Special category data involved" description="" class=" tj_btn_group"><option value="yes">Yes</option><option value="no">No</option></field><field name="com_tjucm_sarlog_justificationifextensionrequired" type="text" label="Justification if extension required" description="" class=""/><field name="com_tjucm_sarlog_descriptionofresponsebruploadcopyofresponseletterbelow" type="textarea" label="Description of response(Upload copy of response letter below)" description="" class="" rows="8" cols="28"/><field name="com_tjucm_sarlog_dateinformationprovided" type="calendar" label="Date information provided" description="" class="dpeCalender calendar-textfield-class" size="22" format="%d-%m-%Y" showtime="false" translateformat="false" filter="user_utc"/><field name="com_tjucm_sarlog_exemptionscited" type="textarea" label="Exemptions cited" description="" class="" cols="28"/><field name="com_tjucm_sarlog_chargeappliedfoi" type="text" label="Charge applied" description="" class=""/><field name="com_tjucm_sarlog_requeststatus" type="radio" label="Request status" description="" required="true" class=" tj_btn_group" default="Open"><option value="Open">Open</option><option value="In progress">In progress</option><option value="Closed">Closed</option></field><field name="com_tjucm_sarlog_saracceptedandclosed" type="calendar" label="Request finalised and closed" description="" class="dpeCalender calendar-textfield-class" size="22" format="%d-%m-%Y" showtime="false" translateformat="false" weeknumbers="false" filter="user_utc"/><field name="com_tjucm_sarlog_files" type="ucmsubform" label="Files" description="" class="twoColumnUcmsubform" formsource="components/com_tjucm/models/forms/fileuploadsarform_extra.xml" layout="joomla.form.field.subform.repeatable" groupbysubform="true" buttons="add,remove" multiple="true" min="1" max="1000"/><field name="