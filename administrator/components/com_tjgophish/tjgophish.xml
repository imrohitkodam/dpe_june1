<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="3.0" method="upgrade">
	<name>COM_TJGOPHISH</name>
	<author>Techjoomla</author>
	<authorEmail>extensions@techjoomla.com</authorEmail>
	<authorUrl>https://techjoomla.com</authorUrl>
	<creationDate>26th Oct 2020</creationDate>
	<copyright>Copyright (C) 2010 - 2020 Techjoomla. All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<version>1.0.0</version>
	<description>COM_TJGOPHISH_DESCRIPTION</description>
	<scriptfile>script.tjgophish.php</scriptfile>
	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>
	<media destination="com_tjgophish" folder="media">
		<folder>images</folder>
		<folder>css</folder>
		<folder>js</folder>
		<filename>index.html</filename>
	</media>
	<files folder="site">
		<filename>index.html</filename>
		<filename>tjgophish.php</filename>
		<filename>controller.php</filename>
		<filename>router.php</filename>
		<folder>views</folder>
		<folder>models</folder>
		<folder>includes</folder>
		<folder>controllers</folder>
	</files>
	<languages folder="site/language">
		<language tag="en-GB">en-GB/en-GB.com_tjgophish.ini</language>
	</languages>
	<administration>
		<files folder="admin">
			<filename>index.html</filename>
			<filename>config.xml</filename>
			<filename>tjgophish.php</filename>
			<filename>controller.php</filename>
			<filename>access.xml</filename>
			<folder>sql</folder>
			<folder>helpers</folder>
		</files>
		<languages folder="admin/language">
			<language tag="en-GB">en-GB/en-GB.com_tjgophish.ini</language>
			<language tag="en-GB">en-GB/en-GB.com_tjgophish.sys.ini</language>
		</languages>
	</administration>
</extension>
