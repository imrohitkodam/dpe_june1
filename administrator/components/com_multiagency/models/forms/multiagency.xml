		<field name="title" type="text" required="true" label="COM_MULTIAGENCY_FORM_LBL_MULTIAGENCY_TITLE" description="COM_MULTIAGENCY_FORM_DESC_MULTIAGENCY_TITLE" hint="COM_MULTIAGENCY_FORM_LBL_MULTIAGENCY_TITLE" />
