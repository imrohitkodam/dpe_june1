		<field name="country_id" type="list	" required="true" multiple="false" label="COM_MULTIAGENCY_FORM_LBL_MULTIAGENCY_COUNTRY_ID" description="COM_MULTIAGENCY_FORM_DESC_MULTIAGENCY_COUNTRY_ID" hint="COM_MULTIAGENCY_FORM_LBL_MULTIAGENCY_COUNTRY_ID" />
		<field name="state_id" type="list" required="true" multiple="false" label="COM_MULTIAGENCY_FORM_LBL_MULTIAGENCY_STATE_ID" description="COM_MULTIAGENCY_FORM_DESC_MULTIAGENCY_STATE_ID" hint="COM_MULTIAGENCY_FORM_LBL_MULTIAGENCY_STATE_ID" />
	</fieldset>
	<fieldset name="accesscontrol">
		<field name="asset_id" type="hidden" filter="unset" />
		<field name="rules" type="rules" label="JFIELD_RULES_LABEL" translate_label="false" filter="rules" validate="rules" class="inputbox" component="com_multiagency" section="multiagency" />
	</fieldset>
</form>
