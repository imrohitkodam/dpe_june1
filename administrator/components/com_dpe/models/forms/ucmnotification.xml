<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset addfieldpath="/administrator/components/com_dpe/models/fields">
		<field name="ucmfieldvalue" type="text" readonly="true" label="COM_DPE_UCM_BACKEND_STATUS" />
		<field name="fieldoption" type="subform" label="" description="" layout="joomla.form.field.subform.repeatable-table" icon="list" multiple="true" min="1">
			<form hidden="true" name="list_templates_modal" repeat="true">
				
				<field
				name="sendNotificationto"
				type="list"
				label="COM_DPE_UCM_SEND_NOTIFICATION_TO"
				description="COM_DPE_UCM_SEND_NOTIFICATION_TO"
				onchange="getNotificationType(event);"
				default="id DESC"
				>
				<option value="userdefinedemail">COM_TJUCM_NOTIFICSTION_TJNOTIFICTION_USERDEFINED_EMAIL</option>
				<option value="specificemail">COM_TJUCM_NOTIFICSTION_TJNOTIFICTION_SPECIFIC_EMAIL</option>
			   </field>
			   <field
				name="sendnotificationfield"
				type="list"
				class=""
				>
				<option value="">COM_TJUCM_NOTIFICSTION_TJNOTIFICTION_USERDEFINED_FIELD_TYPE</option>
			   </field>
			   <field name="sendnotificationemail" class="d-none validate-email" type="text" hint="COM_TJUCM_NOTIFICSTION_TJNOTIFICTION_SPECIFIC_EMAIL" label="COM_TJUCM_NOTIFICSTION_TJNOTIFICTION" required="" filter="raw" />
			   <field name="uniquekeytjnotification" class="uniquekeytjnotification" type="text" hint="COM_DPE_TJUCM_ADD_NOTIFICATION_KEY"  label="" required="true" onchange="getUniqueKeyUrl(this)" filter="raw"/>
			</form>
		</field>
	</fieldset>
</form>
