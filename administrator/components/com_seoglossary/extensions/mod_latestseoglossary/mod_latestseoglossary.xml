<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.0" method="upgrade" client="site">
	<name>SEO Glossary List</name>
	<author>JoomUnited</author>
	<authorEmail>contact@joomunited.com</authorEmail>
	<authorUrl>http://www.joomunited.com</authorUrl>
	<creationDate>2023-07-31 09:17:38</creationDate>
	<copyright>(c) 2012 JoomUnited (http://www.joomunited.com). All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; http://www.gnu.org/licenses/gpl-2.0.html</license>
	<version>3.2.5</version>
	<description>Module to Show List of the Glossary</description>
	<files>
		<filename>helper.php</filename>
		<filename>index.html</filename>
		<filename module="mod_latestseoglossary">mod_latestseoglossary.php</filename>
		<filename>mod_latestseoglossary.xml</filename>
		<folder>tmpl</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic"  addfieldpath="/administrator/components/com_seoglossary/models/fields">
				 <field name="lang" type="lang"   description="" />
				<field name="theme"
				type="radio"
               class="btn-group"
               default="0"
               label="COM_SEOGLOSSARY_COMPONENT_THEME"
               description="COM_SEOGLOSSARY_COMPONENT_THEME_DESCRIPTION"
				>
				<option value="0" >COM_SEOGLOSSARY_LBL_MENU</option>
				<option value="1">COM_SEOGLOSSARY_LBL_SLIDE</option>
				</field>
			 <field name="mode"
               type="radio"
               class="btn-group"
               default="1"
               label="COM_SEOGLOSSARY_FORM_DISPLAY_MODE"
               description="COM_SEOGLOSSARY_FORM_DISPLAY_MODE" showon="theme:0">
            <option value="0" >COM_SEOGLOSSARY_LBL_TITLELIST</option>
            <option value="1">COM_SEOGLOSSARY_LBL_DESCLIST</option>
	    <option value="2">COM_SEOGLOSSARY_LBL_INTROLIST</option>
        </field>
			 <field name="coloumn" type="list" default="3" label="COM_SEOGLOSSARY_FORM_COLOUMN" description="COM_SEOGLOSSARY_FORM_COLOUMN_DESC" showon="theme:1">
		<option value="1">1</option>
		<option value="2">2</option>
		<option value="3">3</option>
	</field>
			 
				<field
				name="count"
				type="text"
				default="5"
				label="COM_SEOGLOSSARY_LBL_NUMBER"
				filter="integer"
				description="COM_SEOGLOSSARY_LBL_NUMBER" />
				
				<field
				name="count_intro"
				type="text"
				default="50"
				label="COM_SEOGLOSSARY_LBL_INTRO"
				filter="integer"
				description="COM_SEOGLOSSARY_LBL_INTRO" />
				<field name="catid" type="sql" default="JSELECT" label="COM_SEOGLOSSARY_DESC_SELECTGLOSSARY" query="SELECT id, name FROM #__seoglossaries where state=1" key_field="id" value_field="name" multiple="multiple" description="COM_SEOGLOSSARY_DESC_SELECTGLOSSARY"/>
				
				<field name="ordering"
               type="list"
               default="id"
               label="JFIELD_ORDERING_LABEL"
               description="JFIELD_ORDERING_DESC">
            <option value="id" >JGLOBAL_MOST_RECENT_FIRST</option>
            <option value="tterm">JGLOBAL_TITLE_ALPHABETICAL</option>
            <option value="rand()">JGLOBAL_RANDOM_ORDER</option>
			<option value="order">JGLOBAL_ORDERING</option>
	    </field>
        		<field name="ordering_direction"
               type="list"
               default="desc"
               label="JGLOBAL_ORDER_DIRECTION_LABEL"
               description="JGLOBAL_ORDER_DIRECTION_DESC">
            <option value="asc" >JGLOBAL_ORDER_ASCENDING</option>
            <option value="desc">JGLOBAL_ORDER_DESCENDING</option>
        </field>
			<field name="bootstrap_layout"
               type="list"
               default="sidebar"
               label="JGLOBAL_CATEGORY_LAYOUT_LABEL"
               description="JGLOBAL_CATEGORY_LAYOUT_DESC">
		<option value="flat" >COM_SEOGLOSSARY_LBL_FLAT</option>
		<option value="sidebar">COM_SEOGLOSSARY_LBL_BOOTSTRAP_SIDE</option>
		<option value="nav">COM_SEOGLOSSARY_LBL_BOOTSTRAP_TOP</option>
	 </field>	
				
			</fieldset>
			<fieldset name="advanced">
				<field
				name="layout"
				type="modulelayout"
				label="JFIELD_ALT_LAYOUT_LABEL"
				description="JFIELD_ALT_MODULE_LAYOUT_DESC" />
				<field
				name="moduleclass_sfx"
				type="text"
				label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
				description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
				<field
				name="cache"
				type="list"
				default="1"
				label="COM_MODULES_FIELD_CACHING_LABEL"
				description="COM_MODULES_FIELD_CACHING_DESC">
					<option
					value="1">JGLOBAL_USE_GLOBAL</option>
					<option
					value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>
				<field
				name="cache_time"
				type="text"
				default="900"
				label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
				description="COM_MODULES_FIELD_CACHE_TIME_DESC" />
				<field
				name="cachemode"
				type="hidden"
				default="static">
					<option
					value="static"></option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
