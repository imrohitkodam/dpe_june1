<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="xmap" version="2.5" method="upgrade">
    <name>Xmap/OSMAP - Seoglossary</name>
    <creationDate>2023-07-31 09:17:38</creationDate>
	<copyright>(c) 2012 JoomUnited (http://www.joomunited.com). All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; http://www.gnu.org/licenses/gpl-2.0.html</license>
    <author>JoomUnited</author>
	<authorEmail>contact@joomunited.com</authorEmail>
	<authorUrl>http://www.joomunited.com</authorUrl>
	<version>3.2.5</version>
	<description>SEO Glossary Xmap plugin is a sitemap of glossary, definitions of terms and also for SEO need with internal links.</description>
    <files>
        <filename plugin="com_seoglossary">com_seoglossary.php</filename>
        <filename>index.html</filename>
    </files>
    <config>
        <fields name="params"  addfieldpath="/administrator/components/com_seoglossary/models/fields">
			<field name="lang" type="lang"   description="" />
            <fieldset name="basic">
                <field name="include_glossary" type="list" default="1" label="Show Seo Glossary Items" description="Show Seo Glossary Items">
                    <option value="0">Never</option>
                    <option value="1">Always</option>
                    <option value="2">In XML Sitemap Only</option>
                    <option value="3">In HTML Sitemap Only</option>
                </field>
                <field name="priority" type="list" default="0.5" label="Priority" description="Set the priority">
                    <option value="-1">Use Parent Menu Settings</option>
                    <option value="0.0">0.0</option>
                    <option value="0.1">0.1</option>
                    <option value="0.2">0.2</option>
                    <option value="0.3">0.3</option>
                    <option value="0.4">0.4</option>
                    <option value="0.5">0.5</option>
                    <option value="0.6">0.6</option>
                    <option value="0.7">0.7</option>
                    <option value="0.8">0.8</option>
                    <option value="0.9">0.9</option>
                    <option value="1">1</option>
                </field>
                <field name="changefreq" type="list" default="weekly" label="Change frequency" description="Set the change frequency.">
                    <option value="-1">Use Parent Menu Settings</option>
                    <option value="always">Always</option>
                    <option value="hourly">Hourly</option>
                    <option value="daily">Daily</option>
                    <option value="weekly">Weekly</option>
                    <option value="monthly">Monthly</option>
                    <option value="yearly">Yearly</option>
                    <option value="never">Never</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
