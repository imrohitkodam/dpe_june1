<?xml version="1.0" encoding="utf-8"?>
<form>
<fieldset addfieldpath="/administrator/components/com_tjcompetency/models/fields">
	<fields name="filter">

		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_SEARCH_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_SEARCH_LABEL_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="user_id"
			type="CompetencyUsers"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_USER_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_USER_DESC"
			multiple="true"
			class="multipleUsers"
			onchange="this.form.submit();"
			>
			<!-- <option value="0">JNONE</option> -->
		</field>

		<field
			name="client"
			type="CompetencyContentTypes"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FORM_LBL_CONTENT_TYPE"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FORM_DESC_CONTENT_TYPE"
			useinfilter="true"
			onchange="this.form.submit();"
			class="multipleContentTypes"
			multiple="false"
		/>

		<field
			name="client_id"
			type="CompetencyContents"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_CONTENT_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_CONTENT_DESC"
			onchange="this.form.submit();"
			class="multipleContents"
			multiple="true"
			dependant="true"
		/>

		<field
			name="framework_id"
			type="competencyframeworks"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_FRAMEWORK_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_FRAMEWORK_DESC"
			onchange="this.form.submit();"
			multiple="true"
			class="multipleFrameworks"
		/>

		<field
			name="skill_id"
			type="skilledit"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_SKILL_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_SKILL_DESC"
			onchange="this.form.submit();"
			multiple="true"
			class="multipleSkills"
			hide_root="true"
		/>

		<field
			name="scale_id"
			type="scales"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_SCALE_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_SCALE_DESC"
			onchange="this.form.submit();"
			multiple="true"
			class="multipleScales"
		/>

		<field
			name="created_by"
			type="sql"
			query="SELECT DISTINCT (`cf`.`created_by`) as tmpl_created_by, u.name FROM `#__tjcompetency_skill_user_content_map` AS cf LEFT JOIN `#__users` AS u ON (cf.created_by = u.id)"
			key_field="tmpl_created_by"
			value_field="name"
			filter="safehtml"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_CREATED_BY_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_CREATED_BY_DESC"
			onchange="this.form.submit();">
			<option value="">COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_CREATED_BY_SELECT_USER</option>
		</field>

		<field
			name="state"
			type="status"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_STATUS_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_FILTER_STATUS_DESC"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
			<option value="3">COM_COMPETENCY_COMPETENCY_SKILLCONTENTUSERMAP_STATE_OPTION_INREVIEW</option>
		</field>
	</fields>

	<fields name="list">

		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			description="JGLOBAL_SORT_BY"
			default="a.id ASC"
			statuses="*,0,1,2,-2"
			onchange="this.form.submit();"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			class="input-mini"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</fieldset>
</form>
