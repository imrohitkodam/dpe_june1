<?xml version="1.0" encoding="utf-8"?>
<form>
<fieldset addfieldpath="/administrator/components/com_tjcompetency/models/fields">
	<field name="id" type="hidden"/>

	<field
		name="skill_id"
		type="CompetencySkills"
		label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_LBL_SKILL"
		description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_DESC_SKILL"
		required="true"
	/>

	<field
		name="scale_id"
		type="CompetencyScales"
		label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_LBL_SCALE"
		description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_DESC_SCALE"
		required="true"
	/>

	<field
		name="client"
		type="CompetencyContentTypes"
		label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_LBL_CONTENT_TYPE"
		description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_DESC_CONTENT_TYPE"
		required="true"
	/>

<!-- 	<field
		name="client_id"
		type="text"
		label="Client Id"
		description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_DESC_SCALE"
		required="true"
	/> -->

	<field
		name="description"
		type="editor"
		label="JGLOBAL_DESCRIPTION"
		description="COM_CATEGORIES_DESCRIPTION_DESC"
		filter="JComponentHelper::filterText"
		buttons="true"
		hide="readmore,pagebreak"
	/>

	<field
		name="outcome_rule"
		type="list"
		label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_LBL_OUTCOME_RULE"
		description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_DESC_OUTCOME_RULE"
		default="1"
		class="chzn-color-state"
		size="1"
		>
		<option value="1">COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_OUTCOME_RULE_OPTION_MARK_COMPLETE</option>
		<option value="2">COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_OUTCOME_RULE_OPTION_SEND_FOR_REVIEW</option>
		<option value="0">COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_OUTCOME_RULE_OPTION_DO_NOTHING</option>
	</field>

	<field
		name="state"
		type="list"
		label="JSTATUS"
		description="JFIELD_PUBLISHED_DESC"
		default="1"
		class="chzn-color-state"
		size="1"
		>
		<option value="1">JPUBLISHED</option>
		<option value="0">JUNPUBLISHED</option>
		<option value="2">JARCHIVED</option>
		<option value="-2">JTRASHED</option>
	</field>

	<field
		name="created_by"
		type="hidden"
		/>

		<field
			name="modified_on"
			type="hidden"/>

		<field
			name="modified_by"
			type="hidden"
		/>

		<field
			name="created_on"
			type="calendar"
			filter="user_utc"
			format="%Y-%m-%d %H:%M:%S"
			singleheader="true"
			showtime="true"
			timeformat="24"
			todaybutton="false"
			weeknumbers="false"
			filltable="true"
			minyear="-1"
			maxyear="5"
			default="now"
			label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_LBL_CREATED_DATE"
			description="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_DESC_CREATED_DATE"
		/>

		<field
			name="checked_out"
			type="hidden"
			filter="unset"/>

		<field
			name="checked_out_time"
			type="hidden"
			filter="unset"/>

		<fields name="params" label="COM_COMPETENCY_COMPETENCY_SKILLCONTENTMAP_FORM_LBL_PARAMS">
		</fields>
</fieldset>
</form>
