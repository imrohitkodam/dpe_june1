<?xml version="1.0" encoding="utf-8"?>
<form>
<fieldset addfieldpath="/administrator/components/com_tjcompetency/models/fields">
	<fields name="filter">

		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_COMPETENCY_COMPETENCY_SCALE_FILTER_SEARCH_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SCALE_FILTER_SEARCH_LABEL_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="scale_set_id"
			type="competencyscalesets"
			label="COM_COMPETENCY_COMPETENCY_SCALE_FORM_LBL_SCALESET"
			description="COM_COMPETENCY_COMPETENCY_SCALE_FORM_DESC_SCALESET"
			onchange="this.form.submit();"
		/>

		<field
			name="created_by"
			type="sql"
			query="SELECT DISTINCT (`cf`.`created_by`) as tmpl_created_by, u.name FROM `#__tjcompetency_scales` AS cf LEFT JOIN `#__users` AS u ON (cf.created_by = u.id)"
			key_field="tmpl_created_by"
			value_field="name"
			filter="safehtml"
			label="COM_COMPETENCY_COMPETENCY_SCALE_FILTER_CREATED_BY_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SCALE_FILTER_CREATED_BY_DESC"
			onchange="this.form.submit();">
			<option value="">COM_COMPETENCY_COMPETENCY_SCALE_FILTER_CREATED_BY_SELECT_USER</option>
		</field>

		<field
			name="state"
			type="status"
			label="COM_COMPETENCY_COMPETENCY_SCALE_FILTER_STATUS_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SCALE_FILTER_STATUS_DESC"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>

	</fields>

	<fields name="list">

		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			description="JGLOBAL_SORT_BY"
			default="a.lft ASC"
			statuses="*,0,1,2,-2"
			onchange="this.form.submit();"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.sequence_number ASC">COM_COMPETENCY_COMPETENCY_SCALE_FORM_LBL_SEQUENCE_NUMBER_ASC</option>
			<option value="a.sequence_number DESC">COM_COMPETENCY_COMPETENCY_SCALE_FORM_LBL_SEQUENCE_NUMBER_DESC</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			class="input-mini"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</fieldset>
</form>
