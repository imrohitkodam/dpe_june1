<?xml version="1.0" encoding="utf-8"?>
<form>
<fieldset addfieldpath="/administrator/components/com_tjcompetency/models/fields">
	<fields name="filter">

		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_COMPETENCY_COMPETENCY_SKILL_FILTER_SEARCH_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILL_FILTER_SEARCH_LABEL_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="framework_id"
			type="competencyframeworks"
			label="COM_COMPETENCY_COMPETENCY_SKILL_FORM_LBL_FRAMEWORK"
			description="COM_COMPETENCY_COMPETENCY_SKILL_FORM_DESC_FRAMEWORK"
			onchange="this.form.submit();"
			multiple="true"
			class="multipleFrameworks"
		/>

		<field
			name="created_by"
			type="sql"
			query="SELECT DISTINCT (`cf`.`created_by`) as tmpl_created_by, u.name FROM `#__tjcompetency_skills` AS cf LEFT JOIN `#__users` AS u ON (cf.created_by = u.id) WHERE cf.id != 1"
			key_field="tmpl_created_by"
			value_field="name"
			filter="safehtml"
			label="COM_COMPETENCY_COMPETENCY_SKILL_FILTER_CREATED_BY_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILL_FILTER_CREATED_BY_DESC"
			onchange="this.form.submit();">
			<option value="">COM_COMPETENCY_COMPETENCY_SKILL_FILTER_CREATED_BY_SELECT_USER</option>
		</field>

		<field
			name="state"
			type="status"
			label="COM_COMPETENCY_COMPETENCY_SKILL_FILTER_STATUS_LABEL"
			description="COM_COMPETENCY_COMPETENCY_SKILL_FILTER_STATUS_DESC"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>

		<field
			name="level"
			type="integer"
			label="JOPTION_FILTER_LEVEL"
			description="JOPTION_FILTER_LEVEL_DESC"
			first="1"
			last="10"
			step="1"
			languages="*"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_MAX_LEVELS</option>
		</field>
	</fields>

	<fields name="list">

		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			description="JGLOBAL_SORT_BY"
			default="a.lft ASC"
			statuses="*,0,1,2,-2"
			onchange="this.form.submit();"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.lft ASC">JGRID_HEADING_ORDERING_ASC</option>
			<option value="a.lft DESC">JGRID_HEADING_ORDERING_DESC</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			class="input-mini"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</fieldset>
</form>
