<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset addfieldpath="/administrator/components/com_tjcompetency/models/fields">
		<field name="id" type="hidden"/>

		<field name="title"
			type="text"
			label="COM_COMPETENCY_COMPETENCY_SCALESET_FORM_LBL_TITLE"
			description="COM_COMPETENCY_COMPETENCY_SCALESET_FORM_DESC_TITLE"
			required="true"
			filter="safehtml"
		/>

		<field name="description"
			type="editor"
			label="COM_COMPETENCY_COMPETENCY_SCALESET_FORM_LBL_DESCRIPTION"
			description="COM_COMPETENCY_COMPETENCY_SCALESET_FORM_DESC_DESCRIPTION"
			filter="JComponentHelper::filterText"
			buttons="true"
			hide="readmore,pagebreak"
		/>

		<field
			name="state"
			type="list"
			label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC"
			class="chzn-color-state"
			filter="intval"
			size="1"
			default="1"
			>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>

		<!-- <field name="params"
			type="textarea"
			label="COM_COMPETENCY_COMPETENCY_SCALESET_FORM_LBL_PARAMS"
			description="COM_COMPETENCY_COMPETENCY_SCALESET_FORM_DESC_PARAMS"
			rows="10"
			cols="80"
			filter="raw"
		/> -->

		<fields name="params" label="COM_COMPETENCY_COMPETENCY_SCALESET_FORM_LBL_PARAMS">
		</fields>

		<field
			name="created_by"
			type="hidden"
		/>

		<field
			name="modified_on"
			type="hidden"/>

		<field
			name="modified_by"
			type="hidden"
		/>

		<field
			name="created_on"
			type="hidden"/>

		<field
			name="checked_out"
			type="hidden"
			filter="unset"/>

		<field
			name="checked_out_time"
			type="hidden"
			filter="unset"/>
	</fieldset>
</form>
