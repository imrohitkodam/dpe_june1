<?xml version="1.0" encoding="utf-8"?>
<config>
    <fieldset name="license"
              label="COM_SEAICHAT_CONFIG_LICENSE"
              description="COM_SEAICHAT_CONFIG_LICENSE_DESC">

        <field
            name="license_server"
            type="url"
            label="COM_SEAICHAT_CONFIG_LICENSE_SERVER"
            description="COM_SEAICHAT_CONFIG_LICENSE_SERVER_DESC"
            default="https://se24media.co.uk"
            filter="url"
            size="60"
        />

        <field
            name="license_key"
            type="text"
            label="COM_SEAICHAT_CONFIG_LICENSE_KEY"
            description="COM_SEAICHAT_CONFIG_LICENSE_KEY_DESC"
            filter="string"
            size="40"
        />

    </fieldset>

    <fieldset name="aichat_general" label="COM_SEAICHAT_CONFIG_AICHAT" description="COM_SEAICHAT_CONFIG_AICHAT_DESC">
        <field name="aichat_enabled" type="radio" label="COM_SEAICHAT_CONFIG_AICHAT_ENABLED" default="0" class="btn-group btn-group-yesno">
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field
            name="aichat_menu_items"
            type="text"
            label="COM_SEAICHAT_CONFIG_AICHAT_MENU_ITEMS"
            description="COM_SEAICHAT_CONFIG_AICHAT_MENU_ITEMS_DESC"
            default=""
            size="60"
            hint="Comma-separated menu item IDs, or leave empty for all pages"
        />
        <field name="aichat_api_key" type="text" label="COM_SEAICHAT_CONFIG_AICHAT_API_KEY" size="60" hint="Your API key" filter="raw" />
        <field name="aichat_provider" type="list" label="COM_SEAICHAT_CONFIG_AICHAT_PROVIDER" default="anthropic">
            <option value="anthropic">Anthropic (Claude)</option>
            <option value="openai">OpenAI (GPT)</option>
            <option value="gemini">Google (Gemini)</option>
            <option value="deepseek">DeepSeek</option>
        </field>
        <field name="aichat_model" type="list" label="COM_SEAICHAT_CONFIG_AICHAT_MODEL" default="claude-sonnet-4-20250514" showon="aichat_provider:anthropic">
            <option value="claude-sonnet-4-20250514">Claude Sonnet 4</option>
            <option value="claude-haiku-4-5-20251001">Claude Haiku 4.5</option>
        </field>
        <field name="aichat_model_openai" type="list" label="COM_SEAICHAT_CONFIG_AICHAT_MODEL" default="gpt-4o-mini" showon="aichat_provider:openai">
            <option value="gpt-4o">GPT-4o</option>
            <option value="gpt-4o-mini">GPT-4o Mini</option>
            <option value="gpt-4.1-mini">GPT-4.1 Mini</option>
            <option value="gpt-4.1-nano">GPT-4.1 Nano</option>
        </field>
        <field name="aichat_model_gemini" type="list" label="COM_SEAICHAT_CONFIG_AICHAT_MODEL" default="gemini-2.5-flash" showon="aichat_provider:gemini">
            <option value="gemini-2.5-pro">Gemini 2.5 Pro</option>
            <option value="gemini-2.5-flash">Gemini 2.5 Flash</option>
            <option value="gemini-2.5-flash-lite">Gemini 2.5 Flash Lite</option>
            <option value="gemini-2.0-flash">Gemini 2.0 Flash</option>
        </field>
        <field name="aichat_model_deepseek" type="list" label="COM_SEAICHAT_CONFIG_AICHAT_MODEL" default="deepseek-chat" showon="aichat_provider:deepseek">
            <option value="deepseek-chat">DeepSeek Chat (V3)</option>
            <option value="deepseek-reasoner">DeepSeek Reasoner (R1)</option>
        </field>
        <field name="aichat_max_messages" type="number" label="COM_SEAICHAT_CONFIG_AICHAT_MAX_MESSAGES" description="COM_SEAICHAT_CONFIG_AICHAT_MAX_MESSAGES_DESC" default="10" min="2" max="50" />
        <field name="aichat_system_prompt" type="textarea" label="COM_SEAICHAT_CONFIG_AICHAT_SYSTEM_PROMPT" default="You are a helpful AI assistant. Answer questions based on the provided documentation. If you cannot find the answer, say so honestly. Be concise, friendly and professional." rows="6" cols="80" filter="raw" />
        <field name="aichat_welcome_message" type="text" label="COM_SEAICHAT_CONFIG_AICHAT_WELCOME" default="Hi! I'm your AI assistant. Ask me anything — I've read all the documentation!" size="80" />
        <field name="aichat_widget_position" type="list" label="COM_SEAICHAT_CONFIG_AICHAT_POSITION" default="bottom-right">
            <option value="bottom-right">Bottom Right</option>
            <option value="bottom-left">Bottom Left</option>
        </field>
        <field name="aichat_primary_color" type="text" label="COM_SEAICHAT_CONFIG_AICHAT_COLOR" default="#2E486B" maxlength="7" hint="#2E486B" />
        <field
            name="aichat_contact_url"
            type="text"
            label="COM_SEAICHAT_CONFIG_CONTACT_URL"
            description="COM_SEAICHAT_CONFIG_CONTACT_URL_DESC"
            default=""
            size="60"
            hint="https://yoursite.com/contact-us"
        />
        <field
            name="aichat_contact_text"
            type="text"
            label="COM_SEAICHAT_CONFIG_CONTACT_TEXT"
            description="COM_SEAICHAT_CONFIG_CONTACT_TEXT_DESC"
            default="Contact Support"
            size="40"
        />
        <field
            name="aichat_contact_target"
            type="list"
            label="COM_SEAICHAT_CONFIG_CONTACT_TARGET"
            default="_blank"
        >
            <option value="_blank">New Window</option>
            <option value="_self">Same Window</option>
        </field>
    </fieldset>
</config>
