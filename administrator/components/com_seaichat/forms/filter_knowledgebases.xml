<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            label="COM_SEAICHAT_FILTER_SEARCH"
            description="COM_SEAICHAT_FILTER_SEARCH_KB_DESC"
            hint="COM_SEAICHAT_FILTER_SEARCH"
        />
        <field
            name="published"
            type="list"
            label="JSTATUS"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
    </fields>
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="a.ordering ASC"
            onchange="this.form.submit();"
        >
            <option value="a.ordering ASC">JFIELD_ORDERING_LABEL</option>
            <option value="a.title ASC">JGLOBAL_TITLE</option>
            <option value="a.id DESC">JGRID_HEADING_ID</option>
        </field>
    </fields>
</form>
