<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            label="COM_SEAICHAT_FILTER_SEARCH"
            description="COM_SEAICHAT_FILTER_SEARCH_CTA_DESC"
            hint="Search by title, keywords, or button label"
        />
        <field
            name="published"
            type="list"
            label="JSTATUS"
            onchange="this.form.submit();"
        >
            <option value="">- Select Status -</option>
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
    </fields>
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="a.ordering ASC"
            onchange="this.form.submit();"
        >
            <option value="a.ordering ASC">JFIELD_ORDERING_LABEL ASC</option>
            <option value="a.ordering DESC">JFIELD_ORDERING_LABEL DESC</option>
            <option value="a.title ASC">JGLOBAL_TITLE ASC</option>
            <option value="a.title DESC">JGLOBAL_TITLE DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID DESC</option>
        </field>
        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="25"
            onchange="this.form.submit();"
        />
    </fields>
</form>
